# POSIX hooks stay LF so Windows clones with core.autocrlf=true can run them. See BACKLOG.md M0.1.
.githooks/** text eol=lf

# Subtitle fixtures are byte-exact test data: BOMs and line endings are the thing under test.
# Without this, a Windows clone with core.autocrlf=true rewrites every one of them. See BACKLOG.md M1.1.
fixtures/subtitles/** -text

# Generated-cue fixtures are byte-exact too: the expected SRT is compared to what M3.3 renders.
# See BACKLOG.md M3.3.
fixtures/asr/** -text

# Golden schema and seed dumps are compared as text: a Windows clone with core.autocrlf=true
# must not rewrite them. See BACKLOG.md M4.1.
fixtures/projects/** text eol=lf
