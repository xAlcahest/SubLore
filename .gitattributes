# POSIX hooks stay LF so Windows clones with core.autocrlf=true can run them. See BACKLOG.md M0.1.
.githooks/** text eol=lf

# Subtitle fixtures are byte-exact test data: BOMs and line endings are the thing under test.
# Without this, a Windows clone with core.autocrlf=true rewrites every one of them. See BACKLOG.md M1.1.
fixtures/subtitles/** -text
