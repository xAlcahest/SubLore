{
  "name": "sublore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "e2e": "wdio run e2e/wdio.conf.js",
    "e2e:build": "tauri build --debug --no-bundle",
    "e2e:shutdown": "node e2e/scripts/shutdown-check.js",
    "e2e:close-gate": "node e2e/scripts/close-gate-check.js",
    "e2e:close-gate-late-edit": "node e2e/scripts/close-gate-late-edit-check.js",
    "e2e:quit-gate": "node e2e/scripts/quit-gate-check.js",
    "e2e:startup-args": "node e2e/scripts/startup-args-check.js",
    "e2e:no-display": "node e2e/scripts/no-display-check.js",
    "e2e:wayland": "node e2e/scripts/wayland-attach-check.js",
    "e2e:scale": "node e2e/scripts/scaled-surface-check.js",
    "e2e:webview": "node e2e/scripts/webview-paint-check.js",
    "e2e:mpv-context": "node e2e/scripts/mpv-context-check.js",
    "e2e:picker-thread": "node e2e/scripts/picker-thread-check.js",
    "e2e:n1b-battery": "node e2e/scripts/n1b-load-battery.js",
    "e2e:n11-battery": "node e2e/scripts/n11-exit-battery.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "serialize-javascript": "^7.0.5"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@wdio/cli": "^9.31.2",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.4",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "eslint": "^10.9.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.4"
  }
}
