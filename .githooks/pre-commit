#!/bin/sh
# Sublore pre-commit: canonical format and lint checks. See BACKLOG.md M0.1.
set -e

fail() {
	echo "pre-commit: $1" >&2
	echo "pre-commit: commit aborted." >&2
	exit 1
}

repo_root=$(git rev-parse --show-toplevel) || fail "not inside a git work tree"
cd "$repo_root" || fail "cannot enter repo root '$repo_root'"

command -v pnpm >/dev/null 2>&1 || fail "pnpm not found in PATH (see README.md)"
command -v cargo >/dev/null 2>&1 || fail "cargo not found in PATH (see README.md)"

check() {
	echo "pre-commit: $*"
	"$@" || fail "'$*' failed"
}

# Whisper binaries, models and generated speech never enter the repo (CLAUDE.md §8).
# Checked before the slow tools run, so a mistake is caught in a second rather than a minute.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
for path in $staged; do
	case "$path" in
	.whisper/*) fail "'$path' is a build artifact; .whisper/ is never committed" ;;
	*.bin) fail "'$path' looks like a model; models are downloaded, never committed" ;;
	fixtures/audio/*.wav) fail "'$path' is generated speech; commit fixtures/audio/make-speech.sh instead" ;;
	esac
	# A file this large that HEAD does not already have is a binary that slipped through the
	# patterns above. `git ls-files` would see the staged copy, so HEAD is what gets asked.
	if ! git rev-parse --verify -q "HEAD:$path" >/dev/null 2>&1; then
		blob=$(git rev-parse --verify -q ":$path") || continue
		size=$(git cat-file -s "$blob" 2>/dev/null || echo 0)
		if [ "$size" -gt 5242880 ]; then
			fail "'$path' is $size bytes; nothing that large belongs in this repo"
		fi
	fi
done

check pnpm format:check
check pnpm lint
check cargo fmt --check
