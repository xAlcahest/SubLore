# Dependencies
node_modules/

# Build output
dist/
target/

# Tauri generated files
src-tauri/gen/schemas/

# Agent workspace
.omc/

# Logs and editor noise
*.log
.idea/
.DS_Store
*.swp

# Video fixtures are generated, never committed (fixtures/video/make-sample.sh)
fixtures/video/*.mkv

# The whisper.cpp source, both build trees and the two sidecar binaries. Built by
# scripts/build-whisper.sh, never committed (CLAUDE.md §8).
.whisper/

# Speech fixtures are generated, never committed: no voice audio in the repo
# (fixtures/audio/make-speech.sh).
fixtures/audio/*.wav

# Whisper models are downloaded by the user, never committed.
*.bin

# Claude Code workspace. Only the git-identity hook is tracked — without it in the
# clone, a web session commits as `Claude` (owner ruling 2026-08-30). Everything else
# there is local state: session files, settings.local.json, whatever the tool writes.
.claude/*
!.claude/settings.json
!.claude/session-start-git-identity.sh
